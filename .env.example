# Required for AI chat requests. Create a personal .env file from this template.
#
# Only the variable matching ``llm.provider`` in config.yaml needs to be set.
# - llm.provider: openrouter  -> set OPENROUTER_API_KEY
# - llm.provider: openai      -> set OPENAI_API_KEY
OPENROUTER_API_KEY=
OPENAI_API_KEY=